@{
	Layout = "_LabAssistantLayout";
	ViewData["Title"] = "Maintenance Requests";
}

<div class="assistant-page-header"><div><span class="assistant-eyebrow">ASSET CARE</span><h2>Maintenance Requests</h2><p>Monitor reported equipment issues and their repair progress.</p></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-tools"></i><strong>07</strong><span>Total requests</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-hourglass-split"></i><strong>03</strong><span>Pending</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-wrench-adjustable"></i><strong>02</strong><span>In progress</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-check-circle"></i><strong>02</strong><span>Completed</span></div></div></div>
<div class="module-panel mb-4"><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="maintenanceSearch">Search maintenance requests</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="maintenanceSearch" class="form-control" type="search" placeholder="Search equipment or laboratory"></div></div><div class="col-lg-5"><label class="form-label" for="maintenanceStatus">Request status</label><select id="maintenanceStatus" class="form-select"><option>All statuses</option><option>Pending</option><option>In progress</option><option>Completed</option></select></div></div></div>
<div class="module-table table-responsive"><table class="table align-middle"><thead><tr><th>Equipment</th><th>Laboratory</th><th>Reported by</th><th>Issue description</th><th>Request date</th><th>Priority</th><th>Status</th><th>Action</th></tr></thead><tbody><tr><td class="fw-semibold">Digital Oscilloscope</td><td>Electronics Lab</td><td>Ayesha Malik</td><td>Display flickers during measurement.</td><td>08 Nov 2026</td><td><span class="priority-high">High</span></td><td><span class="status-badge pending">Pending</span></td><td><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#maintenanceDetails">View</button></td></tr><tr><td class="fw-semibold">Power Supply Unit</td><td>Electronics Lab</td><td>Samira Khan</td><td>Output voltage is unstable.</td><td>06 Nov 2026</td><td><span class="priority-medium">Medium</span></td><td><span class="status-badge pending">In progress</span></td><td><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#maintenanceDetails">View</button></td></tr><tr><td class="fw-semibold">Network Switch</td><td>Networking Lab</td><td>Hassan Raza</td><td>Port 5 is not detecting a connection.</td><td>02 Nov 2026</td><td><span class="priority-low">Low</span></td><td><span class="status-badge approved">Completed</span></td><td><button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#maintenanceDetails">View</button></td></tr></tbody></table></div>
<div class="modal fade" id="maintenanceDetails" tabindex="-1" aria-labelledby="maintenanceDetailsLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="maintenanceDetailsLabel">Maintenance Request Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><dl class="row mb-0"><dt class="col-5">Equipment</dt><dd class="col-7">Digital Oscilloscope</dd><dt class="col-5">Laboratory</dt><dd class="col-7">Electronics Lab</dd><dt class="col-5">Reported by</dt><dd class="col-7">Ayesha Malik</dd><dt class="col-5">Description</dt><dd class="col-7">Display flickers during measurement and readings become difficult to verify.</dd></dl></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Close</button><button class="btn btn-primary" type="button">Update Status</button></div></div></div></div>
