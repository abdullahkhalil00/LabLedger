@{
	Layout = "_LabAssistantLayout";
	ViewData["Title"] = "Reservation Requests";
}

<div class="assistant-page-header"><div><span class="assistant-eyebrow">REQUEST MANAGEMENT</span><h2>Reservation Requests</h2><p>Review and manage student requests for laboratory equipment.</p></div><a class="btn btn-primary" asp-action="IssueEquipment"><i class="bi bi-box-arrow-up me-2"></i>Issue Equipment</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-list-check"></i><strong>24</strong><span>Total requests</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-hourglass-split"></i><strong>12</strong><span>Pending</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-check-circle"></i><strong>09</strong><span>Approved</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-x-circle"></i><strong>03</strong><span>Rejected</span></div></div></div>
<div class="module-panel mb-4"><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="requestSearch">Search requests</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="requestSearch" class="form-control" type="search" placeholder="Search student or equipment"></div></div><div class="col-lg-5"><label class="form-label" for="requestStatus">Reservation status</label><select id="requestStatus" class="form-select"><option>All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div></div></div>
<div class="module-table table-responsive"><table class="table align-middle"><thead><tr><th>Student</th><th>Registration no.</th><th>Equipment</th><th>Laboratory</th><th>Reservation date</th><th>Time slot</th><th>Status</th><th>Actions</th></tr></thead><tbody><tr><td class="fw-semibold">Ayesha Malik</td><td>CS-2026-031</td><td>Digital Oscilloscope</td><td>Electronics Lab</td><td>10 Nov 2026</td><td>09:00 - 11:00</td><td><span class="status-badge pending">Pending</span></td><td class="text-nowrap"><button class="btn btn-sm btn-light" type="button" title="View"><i class="bi bi-eye"></i></button> <button class="btn btn-sm btn-success" type="button" title="Approve"><i class="bi bi-check-lg"></i></button> <button class="btn btn-sm btn-outline-danger" type="button" title="Reject"><i class="bi bi-x-lg"></i></button></td></tr><tr><td class="fw-semibold">Hassan Raza</td><td>SE-2026-018</td><td>Arduino Uno R3</td><td>Computer Lab 01</td><td>11 Nov 2026</td><td>13:00 - 15:00</td><td><span class="status-badge approved">Approved</span></td><td><button class="btn btn-sm btn-light" type="button"><i class="bi bi-eye"></i></button></td></tr><tr><td class="fw-semibold">Maria Khan</td><td>IT-2026-044</td><td>Network Switch</td><td>Networking Lab</td><td>12 Nov 2026</td><td>10:00 - 12:00</td><td><span class="status-badge rejected">Rejected</span></td><td><button class="btn btn-sm btn-light" type="button"><i class="bi bi-eye"></i></button></td></tr></tbody></table></div>
