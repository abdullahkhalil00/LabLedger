@{
	Layout = "_LabAssistantLayout";
	ViewData["Title"] = "Lab Assistant Dashboard";
}

<section class="assistant-welcome mb-4"><div><span class="assistant-eyebrow">OPERATIONS WORKSPACE</span><h2>Good morning, Samira</h2><p>Keep laboratory resources moving smoothly with a clear view of today's activity.</p></div><i class="bi bi-clipboard2-check"></i></section>

<div class="row g-3 mb-4"><div class="col-6 col-xl"><div class="module-stat"><i class="bi bi-pc-display"></i><strong>248</strong><span>Total equipment</span></div></div><div class="col-6 col-xl"><div class="module-stat"><i class="bi bi-calendar-event"></i><strong>12</strong><span>Pending reservations</span></div></div><div class="col-6 col-xl"><div class="module-stat"><i class="bi bi-box-arrow-up"></i><strong>36</strong><span>Currently issued</span></div></div><div class="col-6 col-xl"><div class="module-stat"><i class="bi bi-clock-history"></i><strong>04</strong><span>Overdue returns</span></div></div><div class="col-6 col-xl"><div class="module-stat"><i class="bi bi-tools"></i><strong>07</strong><span>Maintenance requests</span></div></div></div>

<div class="assistant-section-heading"><div><h3>Recent Reservation Requests</h3><p>Requests waiting for review.</p></div><a asp-action="ReservationRequests">View all</a></div>
<div class="module-table table-responsive mb-4"><table class="table align-middle"><thead><tr><th>Student</th><th>Equipment</th><th>Laboratory</th><th>Date</th><th>Status</th></tr></thead><tbody><tr><td class="fw-semibold">Ayesha Malik</td><td>Digital Oscilloscope</td><td>Electronics Lab</td><td>10 Nov 2026</td><td><span class="status-badge pending">Pending</span></td></tr><tr><td class="fw-semibold">Hassan Raza</td><td>Arduino Uno R3</td><td>Computer Lab 01</td><td>11 Nov 2026</td><td><span class="status-badge approved">Approved</span></td></tr><tr><td class="fw-semibold">Maria Khan</td><td>Network Switch</td><td>Networking Lab</td><td>12 Nov 2026</td><td><span class="status-badge pending">Pending</span></td></tr></tbody></table></div>

<div class="assistant-section-heading"><div><h3>Recently Issued Equipment</h3><p>Items currently assigned to students.</p></div><a asp-action="ReturnEquipment">Manage returns</a></div>
<div class="module-table table-responsive mb-4"><table class="table align-middle"><thead><tr><th>Student</th><th>Equipment</th><th>Issue date</th><th>Expected return</th><th>Status</th></tr></thead><tbody><tr><td class="fw-semibold">Bilal Ahmed</td><td>Raspberry Pi 4</td><td>06 Nov 2026</td><td>13 Nov 2026</td><td><span class="status-badge approved">Issued</span></td></tr><tr><td class="fw-semibold">Noor Fatima</td><td>Arduino Uno R3</td><td>05 Nov 2026</td><td>12 Nov 2026</td><td><span class="status-badge approved">Issued</span></td></tr></tbody></table></div>

<div class="assistant-section-heading"><div><h3>Quick Actions</h3><p>Common operations at your fingertips.</p></div></div><div class="row g-3"><div class="col-md-4"><a class="assistant-action" asp-action="ReservationRequests"><i class="bi bi-calendar2-check"></i><span>Review reservations</span><i class="bi bi-arrow-up-right ms-auto"></i></a></div><div class="col-md-4"><a class="assistant-action" asp-action="IssueEquipment"><i class="bi bi-box-arrow-up"></i><span>Issue equipment</span><i class="bi bi-arrow-up-right ms-auto"></i></a></div><div class="col-md-4"><a class="assistant-action" asp-action="MaintenanceRequests"><i class="bi bi-tools"></i><span>Check maintenance</span><i class="bi bi-arrow-up-right ms-auto"></i></a></div></div>
