@{
	Layout = "_LabAssistantLayout";
	ViewData["Title"] = "Return Equipment";
}

<div class="assistant-page-header"><div><span class="assistant-eyebrow">EQUIPMENT CHECK-IN</span><h2>Return Equipment</h2><p>Track issued equipment and record completed returns.</p></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-md-4"><div class="module-stat"><i class="bi bi-box-seam"></i><strong>36</strong><span>Issued equipment</span></div></div><div class="col-6 col-md-4"><div class="module-stat"><i class="bi bi-check2-circle"></i><strong>18</strong><span>Returned this month</span></div></div><div class="col-6 col-md-4"><div class="module-stat"><i class="bi bi-exclamation-circle"></i><strong>04</strong><span>Overdue returns</span></div></div></div>
<div class="module-panel mb-4"><div class="row g-3"><div class="col-lg-7"><label class="form-label" for="returnSearch">Search issued equipment</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="returnSearch" class="form-control" type="search" placeholder="Search student or equipment"></div></div><div class="col-lg-5"><label class="form-label" for="returnStatus">Return status</label><select id="returnStatus" class="form-select"><option>All statuses</option><option>Issued</option><option>Overdue</option><option>Returned</option></select></div></div></div>
<div class="module-table table-responsive"><table class="table align-middle"><thead><tr><th>Student</th><th>Registration no.</th><th>Equipment</th><th>Issue date</th><th>Expected return</th><th>Status</th><th>Action</th></tr></thead><tbody><tr><td class="fw-semibold">Bilal Ahmed</td><td>CS-2026-022</td><td>Raspberry Pi 4</td><td>06 Nov 2026</td><td>13 Nov 2026</td><td><span class="status-badge approved">Issued</span></td><td><button class="btn btn-sm btn-primary" type="button">Process return</button></td></tr><tr class="table-warning"><td class="fw-semibold">Noor Fatima</td><td>IT-2026-011</td><td>Arduino Uno R3</td><td>01 Nov 2026</td><td>08 Nov 2026</td><td><span class="status-badge rejected">Overdue</span></td><td><button class="btn btn-sm btn-warning" type="button">Process return</button></td></tr><tr><td class="fw-semibold">Usman Ali</td><td>SE-2026-040</td><td>Network Switch</td><td>03 Nov 2026</td><td>07 Nov 2026</td><td><span class="status-badge approved">Returned</span></td><td><button class="btn btn-sm btn-light" type="button" disabled>Completed</button></td></tr></tbody></table></div>
