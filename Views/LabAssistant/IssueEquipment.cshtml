@{
	Layout = "_LabAssistantLayout";
	ViewData["Title"] = "Issue Equipment";
}

<div class="assistant-page-header"><div><span class="assistant-eyebrow">EQUIPMENT CHECKOUT</span><h2>Issue Equipment</h2><p>Record equipment issued to a student from an approved request.</p></div></div>
<div class="module-panel assistant-form-panel"><form><div class="row g-3"><div class="col-md-6"><label class="form-label" for="issueStudent">Student</label><select id="issueStudent" class="form-select" required><option value="">Select student</option><option>Ayesha Malik</option><option>Hassan Raza</option><option>Maria Khan</option></select></div><div class="col-md-6"><label class="form-label" for="registrationNumber">Registration number</label><input id="registrationNumber" class="form-control" placeholder="e.g. CS-2026-031" required></div><div class="col-md-6"><label class="form-label" for="issueEquipment">Equipment</label><select id="issueEquipment" class="form-select" required><option value="">Select equipment</option><option>Arduino Uno R3</option><option>Digital Oscilloscope</option><option>Network Switch</option></select></div><div class="col-md-6"><label class="form-label" for="issueLaboratory">Laboratory</label><select id="issueLaboratory" class="form-select" required><option value="">Select laboratory</option><option>Computer Lab 01</option><option>Electronics Lab</option><option>Networking Lab</option></select></div><div class="col-md-4"><label class="form-label" for="issueDate">Issue date</label><input id="issueDate" class="form-control" type="date" value="2026-11-09" required></div><div class="col-md-4"><label class="form-label" for="returnDate">Expected return date</label><input id="returnDate" class="form-control" type="date" required></div><div class="col-md-4"><label class="form-label" for="issueQuantity">Quantity</label><input id="issueQuantity" class="form-control" type="number" min="1" value="1" required></div><div class="col-12"><label class="form-label" for="issueNotes">Notes</label><textarea id="issueNotes" class="form-control" rows="4" placeholder="Add condition notes or accessories issued with the equipment."></textarea></div><div class="col-12"><button class="btn btn-primary" type="button"><i class="bi bi-box-arrow-up me-2"></i>Issue Equipment</button></div></div></form></div>
