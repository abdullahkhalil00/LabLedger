@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Manage Equipment";
}

<div class="admin-page-header"><div><span class="admin-eyebrow">ASSET INVENTORY</span><h2>Manage Equipment</h2><p>Maintain equipment records, quantities, and operational status.</p></div><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#equipmentModal"><i class="bi bi-plus-lg me-2"></i>Add Equipment</button></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-pc-display"></i><strong>248</strong><span>Total equipment</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-check-circle"></i><strong>168</strong><span>Available</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-box-seam"></i><strong>56</strong><span>Issued</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-tools"></i><strong>24</strong><span>Maintenance</span></div></div></div>
<div class="module-panel mb-4"><div class="row g-3"><div class="col-lg-5"><label class="form-label" for="equipmentSearch">Search equipment</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="equipmentSearch" class="form-control" type="search" placeholder="Search equipment"></div></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select"><option>All categories</option><option>Computing</option><option>Electronics</option><option>Networking</option></select></div><div class="col-md-4"><label class="form-label">Laboratory</label><select class="form-select"><option>All laboratories</option><option>Computer Lab 01</option><option>Electronics Lab</option><option>Networking Lab</option></select></div></div></div>
<div class="module-table table-responsive"><table class="table align-middle"><thead><tr><th>Equipment</th><th>Category</th><th>Laboratory</th><th>Total quantity</th><th>Available</th><th>Condition</th><th>Status</th><th>Actions</th></tr></thead><tbody><tr><td class="fw-semibold">Arduino Uno R3</td><td>Computing</td><td>Computer Lab 01</td><td>15</td><td>12</td><td>Good</td><td><span class="status-badge approved">Available</span></td><td><button class="btn btn-sm btn-light" type="button"><i class="bi bi-pencil"></i></button> <button class="btn btn-sm btn-outline-danger" type="button"><i class="bi bi-trash"></i></button></td></tr><tr><td class="fw-semibold">Digital Oscilloscope</td><td>Electronics</td><td>Electronics Lab</td><td>10</td><td>2</td><td>Fair</td><td><span class="status-badge pending">Limited</span></td><td><button class="btn btn-sm btn-light" type="button"><i class="bi bi-pencil"></i></button> <button class="btn btn-sm btn-outline-danger" type="button"><i class="bi bi-trash"></i></button></td></tr><tr><td class="fw-semibold">Managed Network Switch</td><td>Networking</td><td>Networking Lab</td><td>8</td><td>0</td><td>Repair</td><td><span class="status-badge rejected">Maintenance</span></td><td><button class="btn btn-sm btn-light" type="button"><i class="bi bi-pencil"></i></button> <button class="btn btn-sm btn-outline-danger" type="button"><i class="bi bi-trash"></i></button></td></tr></tbody></table></div>
<div class="modal fade" id="equipmentModal" tabindex="-1" aria-labelledby="equipmentModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="equipmentModalLabel">Add Equipment</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Equipment name</label><input class="form-control" required></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select"><option>Computing</option><option>Electronics</option><option>Networking</option></select></div><div class="col-md-3"><label class="form-label">Quantity</label><input class="form-control" type="number" min="1" value="1"></div><div class="col-md-6"><label class="form-label">Laboratory</label><select class="form-select"><option>Computer Lab 01</option><option>Electronics Lab</option></select></div><div class="col-md-6"><label class="form-label">Condition</label><select class="form-select"><option>Good</option><option>Fair</option><option>Needs inspection</option></select></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="button">Save Equipment</button></div></div></div></div>
