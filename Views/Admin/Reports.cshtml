@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "System Reports";
}

<div class="admin-page-header"><div><span class="admin-eyebrow">INSIGHTS AND ANALYTICS</span><h2>System Reports</h2><p>Review usage, reservations, and maintenance activity across LabLedger.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print Report</button><button class="btn btn-primary" type="button"><i class="bi bi-download me-2"></i>Export Report</button></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-pc-display"></i><strong>248</strong><span>Total equipment</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-calendar-check"></i><strong>312</strong><span>Total reservations</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-box-arrow-up"></i><strong>56</strong><span>Equipment issued</span></div></div><div class="col-6 col-xl-3"><div class="module-stat"><i class="bi bi-tools"></i><strong>07</strong><span>Maintenance requests</span></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="module-panel h-100"><h4>Equipment Usage Summary</h4><p class="text-muted small">Distribution of the current equipment inventory.</p><div class="report-bar-row"><span>Available</span><div class="report-bar"><span style="width: 68%"></span></div><strong>68%</strong></div><div class="report-bar-row"><span>Issued</span><div class="report-bar"><span style="width: 23%"></span></div><strong>23%</strong></div><div class="report-bar-row"><span>Maintenance</span><div class="report-bar"><span style="width: 10%"></span></div><strong>10%</strong></div></div></div><div class="col-lg-5"><div class="module-panel h-100"><h4>Reservation Status</h4><p class="text-muted small">312 reservations recorded this term.</p><div class="donut-summary"><div class="donut-chart"><strong>312</strong><small>Total</small></div><div><div><span class="legend-dot approved-dot"></span>Approved <strong>214</strong></div><div><span class="legend-dot pending-dot"></span>Pending <strong>64</strong></div><div><span class="legend-dot rejected-dot"></span>Rejected <strong>34</strong></div></div></div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="module-panel"><h4>Monthly Reservation Report</h4><p class="text-muted small">Reservation volume over the last six months.</p><div class="monthly-chart"><div><span style="height: 42%"></span><small>Jun</small></div><div><span style="height: 58%"></span><small>Jul</small></div><div><span style="height: 51%"></span><small>Aug</small></div><div><span style="height: 70%"></span><small>Sep</small></div><div><span style="height: 82%"></span><small>Oct</small></div><div><span style="height: 94%"></span><small>Nov</small></div></div></div></div><div class="col-lg-5"><div class="module-panel"><h4>Maintenance Status</h4><p class="text-muted small">Current maintenance request breakdown.</p><div class="maintenance-summary"><div><strong>03</strong><span>Pending</span></div><div><strong>02</strong><span>In progress</span></div><div><strong>02</strong><span>Completed</span></div></div></div></div></div>
