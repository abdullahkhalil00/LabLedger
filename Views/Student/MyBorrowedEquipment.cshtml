@{
	Layout = "_StudentLayout";
	ViewData["Title"] = "My Borrowed Equipment";
}

<div class="student-page-header"><div><span class="module-eyebrow">CURRENT LOANS</span><h2>My Borrowed Equipment</h2><p>Keep track of equipment currently issued to you and upcoming return dates.</p></div><a class="btn btn-outline-primary" asp-action="ReportDamage"><i class="bi bi-exclamation-triangle me-2"></i>Report Damage</a></div>
