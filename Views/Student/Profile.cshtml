@{
	Layout = "_StudentLayout";
	ViewData["Title"] = "My Profile";
}

<div class="student-page-header"><div><span class="module-eyebrow">ACCOUNT SETTINGS</span><h2>My Profile</h2><p>Review your student information and account preferences.</p></div><button class="btn btn-primary" type="button"><i class="bi bi-pencil me-2"></i>Edit Profile</button></div>
<div class="row g-4"><div class="col-lg-4"><div class="module-panel text-center profile-card"><div class="profile-image-placeholder"><i class="bi bi-person"></i></div><h4>Alex Johnson</h4><p class="text-muted mb-1">STU-2026-0142</p><span class="badge rounded-pill text-bg-primary">Student</span><hr><p class="small text-muted mb-0">Computer Science Department<br>Semester 5</p></div></div><div class="col-lg-8"><div class="module-panel mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><h4 class="mb-0">Personal Information</h4><button class="btn btn-sm btn-outline-primary" type="button">Edit details</button></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" value="Alex Johnson" readonly></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" value="alex.johnson@university.edu" readonly></div><div class="col-md-6"><label class="form-label">Registration number</label><input class="form-control" value="STU-2026-0142" readonly></div><div class="col-md-6"><label class="form-label">Department</label><input class="form-control" value="Computer Science" readonly></div><div class="col-md-6"><label class="form-label">Semester</label><input class="form-control" value="5th Semester" readonly></div></div></div><div class="module-panel"><h4>Change Password</h4><p class="text-muted small">Update your password regularly to keep your account secure.</p><div class="row g-3"><div class="col-md-6"><label class="form-label">Current password</label><input class="form-control" type="password"></div><div class="col-md-6"><label class="form-label">New password</label><input class="form-control" type="password"></div><div class="col-md-6"><label class="form-label">Confirm new password</label><input class="form-control" type="password"></div></div><button class="btn btn-outline-primary mt-3" type="button">Update Password</button></div></div></div>
