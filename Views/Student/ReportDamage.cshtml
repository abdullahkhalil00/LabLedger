@{
	Layout = "_StudentLayout";
	ViewData["Title"] = "Report Damaged Equipment";
}

<div class="student-page-header"><div><span class="module-eyebrow">EQUIPMENT CARE</span><h2>Report Damaged Equipment</h2><p>Tell the laboratory team about an issue so it can be reviewed quickly.</p></div></div>
<div class="module-panel form-panel"><form><div class="row g-3"><div class="col-md-6"><label class="form-label" for="damageEquipment">Equipment</label><select id="damageEquipment" class="form-select" required><option value="">Select equipment</option><option>Arduino Uno R3</option><option>Raspberry Pi 4</option><option>Digital Oscilloscope</option></select></div><div class="col-md-6"><label class="form-label" for="damageType">Damage type</label><select id="damageType" class="form-select" required><option value="">Select damage type</option><option>Physical damage</option><option>Electrical fault</option><option>Missing component</option><option>Other issue</option></select></div><div class="col-md-6"><label class="form-label" for="damageDate">Date of damage</label><input id="damageDate" class="form-control" type="date" required></div><div class="col-md-6"><label class="form-label" for="damageImage">Optional image</label><input id="damageImage" class="form-control" type="file" accept="image/*"></div><div class="col-12"><label class="form-label" for="damageDescription">Description</label><textarea id="damageDescription" class="form-control" rows="6" placeholder="Describe what happened and include any visible symptoms." required></textarea><div class="form-text">Please provide enough detail for the laboratory assistant to investigate.</div></div><div class="col-12"><button class="btn btn-primary" type="button"><i class="bi bi-send me-2"></i>Submit Report</button></div></div></form></div>
