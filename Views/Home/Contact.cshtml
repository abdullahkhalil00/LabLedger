
@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-page">
<section class="contact-hero">
    <div class="container text-center">
        <span class="contact-label">GET IN TOUCH</span>
        <h1>Contact Us</h1>
        <p>
            Have questions or need assistance?
            We are here to help you.
        </p>
    </div>
</section>

<section class="contact-section">
    <div class="container">
        <div class="row g-4">

            <!-- Contact Information -->
            <div class="col-lg-5">
                <div class="contact-info-card">
                    <h3>Contact Information</h3>
                    <p class="contact-description">
                        Feel free to contact us if you have any
                        questions about laboratory resources.
                    </p>

                    <div class="contact-info-item">
                        <div class="contact-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <h6>Email</h6>
                            <p>support@labledger.com</p>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-icon">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div>
                            <h6>Phone</h6>
                            <p>+92 300 1234567</p>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <h6>Location</h6>
                            <p>University Campus, Lahore, Pakistan</p>
                        </div>
                    </div>

                    <div class="contact-social">
                        <h6>Follow Us</h6>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h3>Send Us a Message</h3>
                    <p>Fill out the form below and we will get back to you.</p>

                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Full Name</label>
                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter your name">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email Address</label>
                                <input type="email"
                                       class="form-control"
                                       placeholder="Enter your email">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter subject">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control"
                                      rows="5"
                                      placeholder="Write your message here"></textarea>
                        </div>

                        <button type="button" class="btn contact-submit-btn">
                            Send Message
                            <i class="bi bi-send ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

</div>
