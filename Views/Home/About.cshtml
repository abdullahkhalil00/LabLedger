
@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">
<!-- Page Hero -->
<section class="about-hero">
    <div class="container text-center">
        <span class="badge bg-warning text-dark px-3 py-2 mb-3">
            ABOUT LABLEDGER
        </span>

        <h1 class="text-white fw-bold display-4">
            About Our Platform
        </h1>

        <p class="text-white-50 mt-3 mx-auto">
            Making university laboratory resource management
            smarter, simpler, and more organized.
        </p>

        <div class="mt-3">
            <a asp-controller="Home"
               asp-action="Index"
               class="text-warning text-decoration-none">
                Home
            </a>
            <span class="text-white-50 mx-2">/</span>
            <span class="text-white">About Us</span>
        </div>
    </div>
</section>

<!-- Introduction -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <span class="about-label">WHO WE ARE</span>

                <h2 class="fw-bold mt-3 mb-4">
                    Simplifying Laboratory Management
                </h2>

                <p class="text-muted about-paragraph">
                    LabLedger is a web-based University Laboratory
                    Resource Management System designed to improve
                    the management of laboratory equipment and resources.
                </p>

                <p class="text-muted about-paragraph">
                    Our platform provides a centralized environment
                    where administrators, laboratory assistants, and
                    students can manage equipment, handle reservations,
                    track inventory, and monitor maintenance activities.
                </p>

                <p class="text-muted about-paragraph">
                    LabLedger aims to reduce manual paperwork,
                    improve equipment accountability, and make
                    laboratory operations more efficient.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="about-visual">
                    <i class="bi bi-buildings"></i>
                    <h3 class="text-white mt-4">LabLedger</h3>
                    <p class="text-white-50">
                        University Laboratory Resource Management
                    </p>

                    <div class="row mt-4 g-3">
                        <div class="col-6">
                            <div class="visual-stat">
                                <i class="bi bi-pc-display"></i>
                                <span>Equipment</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="visual-stat">
                                <i class="bi bi-calendar-check"></i>
                                <span>Reservations</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="visual-stat">
                                <i class="bi bi-box-seam"></i>
                                <span>Inventory</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="visual-stat">
                                <i class="bi bi-tools"></i>
                                <span>Maintenance</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

</div>


<!-- Mission and Vision -->
<section class="mission-section py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="about-label">OUR PURPOSE</span>
            <h2 class="fw-bold mt-2">Mission & Vision</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="purpose-card h-100">
                    <div class="purpose-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <h4 class="fw-bold mt-4">Our Mission</h4>

                    <p class="text-muted">
                        To simplify university laboratory operations
                        by providing a centralized digital platform
                        for managing equipment, reservations,
                        inventory, and maintenance activities.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="purpose-card h-100">
                    <div class="purpose-icon">
                        <i class="bi bi-eye"></i>
                    </div>

                    <h4 class="fw-bold mt-4">Our Vision</h4>

                    <p class="text-muted">
                        To support organized, accessible, and
                        efficient laboratory environments through
                        reliable digital resource management.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- Objectives -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="about-label">WHAT WE AIM TO ACHIEVE</span>
            <h2 class="fw-bold mt-2">Our Objectives</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-database-check"></i>
                    <h5>Centralized Management</h5>
                    <p>
                        Maintain organized records of laboratory
                        equipment and resources in one place.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-calendar2-check"></i>
                    <h5>Easy Reservations</h5>
                    <p>
                        Provide students with a convenient way
                        to request laboratory equipment.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-shield-check"></i>
                    <h5>Better Accountability</h5>
                    <p>
                        Maintain proper issuance, return,
                        and equipment usage records.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-tools"></i>
                    <h5>Equipment Maintenance</h5>
                    <p>
                        Organize damage reporting and
                        equipment repair activities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-clipboard-data"></i>
                    <h5>Accurate Inventory</h5>
                    <p>
                        Monitor available, issued, damaged,
                        and maintained equipment.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="objective-card">
                    <i class="bi bi-graph-up-arrow"></i>
                    <h5>Efficient Operations</h5>
                    <p>
                        Reduce manual work and improve
                        laboratory resource management.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- User Roles -->
<section class="roles-about-section py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="about-label">OUR USERS</span>
            <h2 class="fw-bold mt-2">Who Uses LabLedger?</h2>

            <p class="text-muted">
                Different users work together to manage laboratory resources.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="about-role-card">
                    <i class="bi bi-mortarboard-fill"></i>
                    <h5>Students</h5>
                    <p>
                        Students can explore equipment, submit
                        reservation requests, track borrowed
                        resources, and report damaged equipment.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-role-card">
                    <i class="bi bi-person-workspace"></i>
                    <h5>Lab Assistants</h5>
                    <p>
                        Laboratory assistants manage reservations,
                        issue equipment, process returns,
                        and handle maintenance requests.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-role-card">
                    <i class="bi bi-shield-lock-fill"></i>
                    <h5>Administrators</h5>
                    <p>
                        Administrators manage users, laboratories,
                        equipment, inventory, and system reports.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- Closing Section -->
<section class="about-cta py-5">
    <div class="container text-center">

        <h2 class="fw-bold text-white">
            Better Management Starts Here
        </h2>

        <p class="text-white-50 mt-3">
            Explore a more organized approach to university
            laboratory resource management.
        </p>

        <a asp-controller="Account"
           asp-action="Register"
           class="btn btn-warning btn-lg mt-3">
            Get Started
        </a>

    </div>
</section>

</div>
