<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - LabLedger</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="module-body">
	<div class="module-shell">
		<aside class="module-sidebar">
			<a class="module-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-beaker"></i> LabLedger</a>
			<span class="module-label">ADMINISTRATION</span>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard") ? "active" : "")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Laboratories") ? "active" : "")" asp-controller="Admin" asp-action="Laboratories"><i class="bi bi-building"></i> Laboratories</a>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Equipment") ? "active" : "")" asp-controller="Admin" asp-action="Equipment"><i class="bi bi-pc-display"></i> Equipment</a>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Categories") ? "active" : "")" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags"></i> Categories</a>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Users") ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Users</a>
			<a class="module-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Reports") ? "active" : "")" asp-controller="Admin" asp-action="Reports"><i class="bi bi-bar-chart"></i> Reports</a>
			<span class="module-label mt-4">ACCOUNT</span>
			<a class="module-link" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Public Website</a>
		</aside>
		<main class="module-content">
			<header class="module-topbar"><div><span class="text-muted small">Administration Workspace</span><h1>@ViewData["Title"]</h1></div><div class="module-user"><i class="bi bi-person-circle"></i><span>Morgan Lee<small>Administrator</small></span></div></header>
			@RenderBody()
		</main>
	</div>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
